#include <stdio.h>
int main() {
    int arr[100],n,i,temp;

    printf("enter the number of element:");
    scanf("%d",&n);
    printf("enter %d element:\n,n");
    for(i=0; i<n; i++) {
        scanf("%d",&arr[i]);
    }
    for(i=0; i<n/2; i++) {
        temp=arr[i];
        arr[i]=arr[n-i-1];
        arr[n-i-1]=temp;
    }
    printf("the reversed array is:\n");
    for(i=0; i<n; i++) {
        printf("%d ",arr[i]);
    }
    return 0;
}
